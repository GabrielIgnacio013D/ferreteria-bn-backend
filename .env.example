# Copiar a .env y completar. NUNCA subir el .env real al repositorio.
PORT=3000
DB_HOST=
DB_PORT=5432
DB_NAME=ferreteria_bn
DB_USER=
DB_PASSWORD=
DB_SSL=true

# JWT: el secreto debe tener al menos 32 caracteres. Generarlo con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=15m
JWT_ISSUER=ferreteria-bn-backend
JWT_AUDIENCE=ferreteria-bn-frontend

# Costo del hash bcrypt
BCRYPT_ROUNDS=10
